# Assina sessão e token CSRF. Nunca publique a chave real.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Três barras indicam um arquivo SQLite relativo à pasta instance do Flask.
DATABASE_URL=sqlite:///portfolio.db

# Use 1 somente no computador de desenvolvimento.
FLASK_DEBUG=1

# O seed.py aceita estes valores para automação de deploy. Em uso local,
# deixe-os comentados e informe as credenciais no terminal.
# ADMIN_EMAIL=seu-email@exemplo.com
# ADMIN_PASSWORD=troque-esta-senha

# Destino do botão "Baixar código-fonte" quando o site estiver publicado.
SOURCE_DOWNLOAD_URL=https://github.com/igormauriciomota/seu-repositorio
